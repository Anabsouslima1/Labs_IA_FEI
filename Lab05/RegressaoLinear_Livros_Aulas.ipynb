import pandas as pd
from sklearn.linear_model import LinearRegression
import numpy as np

df_notas = pd.read_csv('/content/notas.csv')

X_notas = df_notas[['livros', 'aulas']]
y_notas = df_notas['notas']

model_notas = LinearRegression()
model_notas.fit(X_notas, y_notas)

slope_livros = model_notas.coef_[0]
slope_frequencia = model_notas.coef_[1]
intercept_notas = model_notas.intercept_

print(f"Livros e Aulas x Notas - Coeficientes da Regressão Linear:")
print(f"  Coeficiente Angular (Livros): {slope_livros:.4f}")
print(f"  Coeficiente Angular (Frequência nas Aulas): {slope_frequencia:.4f}")
print(f"  Coeficiente Linear (Intercepto): {intercept_notas:.4f}")

scenarios = np.array([
    [2, 11],
    [0, 5],
    [4, 20],
    [2, 10],
    [4, 15]
])

predictions_notas = model_notas.predict(scenarios)

print(f"\nPrevisões para Livros e Aulas x Notas:")
for i, scenario in enumerate(scenarios):
    print(f"  Livros: {scenario[0]}, Aulas: {scenario[1]} -> Nota Prevista: {predictions_notas[i]:.2f}")
