import pandas as pd
from sklearn.linear_model import LinearRegression
import numpy as np

df_alpes = pd.read_csv('/content/agua_alpes.csv')

X_alpes = df_alpes[['BPt']]
y_alpes = df_alpes['Pressure']

model_alpes = LinearRegression()
model_alpes.fit(X_alpes, y_alpes)

slope_alpes = model_alpes.coef_[0]
intercept_alpes = model_alpes.intercept_

print(f"Água dos Alpes - Coeficientes da Regressão Linear:")
print(f"  Coeficiente Angular (Inclinação): {slope_alpes:.4f}")
print(f"  Coeficiente Linear (Intercepto): {intercept_alpes:.4f}")

temp_200F = np.array([[200]])
temp_215F = np.array([[215]])

pressure_200F = model_alpes.predict(temp_200F)[0]
pressure_215F = model_alpes.predict(temp_215F)[0]

print(f"\nPrevisões para Água dos Alpes:")
print(f"  Pressão para temperatura de 200 F: {pressure_200F:.4f} polegadas de mercúrio")
print(f"  Pressão para temperatura de 215 F: {pressure_215F:.4f} polegadas de mercúrio")
