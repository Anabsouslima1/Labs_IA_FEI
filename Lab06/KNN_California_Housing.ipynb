import pandas as pd
import numpy as np
from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.neighbors import KNeighborsRegressor
from sklearn.preprocessing import StandardScaler, MinMaxScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
import matplotlib.pyplot as plt
import seaborn as sns

california = fetch_california_housing()
X_cal, y_cal = california.data, california.target

print(f"Formato dos dados (X): {X_cal.shape}")
print(f"Formato dos rótulos (y): {y_cal.shape}")
print("Nomes das features: ", california.feature_names)

# Dividir os dados: 80% treino, 20% teste
X_train_cal, X_test_cal, y_train_cal, y_test_cal = train_test_split(X_cal, y_cal, test_size=0.2, random_state=42)

print(f"\nTamanho do conjunto de treinamento (X_train): {X_train_cal.shape}")
print(f"Tamanho do conjunto de teste (X_test): {X_test_cal.shape}")

def evaluate_regression_model(model, X_train, y_train, X_test, y_test, model_name, scaler_name):
    # Avaliação no conjunto de treinamento
    y_train_pred = model.predict(X_train)
    mae_train = mean_absolute_error(y_train, y_train_pred)
    mse_train = mean_squared_error(y_train, y_train_pred)
    rmse_train = np.sqrt(mse_train)
    r2_train = r2_score(y_train, y_train_pred)

    # Avaliação no conjunto de teste
    y_test_pred = model.predict(X_test)
    mae_test = mean_absolute_error(y_test, y_test_pred)
    mse_test = mean_squared_error(y_test, y_test_pred)
    rmse_test = np.sqrt(mse_test)
    r2_test = r2_score(y_test, y_test_pred)

    print(f"\n--- {model_name} com {scaler_name} ---")
    print(f"Métricas de Treinamento:")
    print(f"  MAE: {mae_train:.4f}")
    print(f"  MSE: {mse_train:.4f}")
    print(f"  RMSE: {rmse_train:.4f}")
    print(f"  R²: {r2_train:.4f}")
    print(f"Métricas de Teste:")
    print(f"  MAE: {mae_test:.4f}")
    print(f"  MSE: {mse_test:.4f}")
    print(f"  RMSE: {rmse_test:.4f}")
    print(f"  R²: {r2_test:.4f}")

    return {
        'model_name': model_name,
        'scaler': scaler_name,
        'mae_train': mae_train, 'mse_train': mse_train, 'rmse_train': rmse_train, 'r2_train': r2_train,
        'mae_test': mae_test, 'mse_test': mse_test, 'rmse_test': rmse_test, 'r2_test': r2_test
    }, y_test_pred

all_regression_results = []
best_r2_test = -np.inf
best_model_info = None
best_model_predictions = None
best_model_actuals = None

# --- Regressão Linear sem Scaling ---
lr_no_scaling = LinearRegression()
lr_no_scaling.fit(X_train_cal, y_train_cal)
metrics, y_pred_lr_no_scaling = evaluate_regression_model(lr_no_scaling, X_train_cal, y_train_cal, X_test_cal, y_test_cal, 'Linear Regression', 'No Scaling')
all_regression_results.append(metrics)

if metrics['r2_test'] > best_r2_test:
    best_r2_test = metrics['r2_test']
    best_model_info = metrics
    best_model_predictions = y_pred_lr_no_scaling
    best_model_actuals = y_test_cal

# --- Regressão Linear com StandardScaler ---
scaler_std = StandardScaler()
X_train_cal_std = scaler_std.fit_transform(X_train_cal)
X_test_cal_std = scaler_std.transform(X_test_cal)

lr_std_scaling = LinearRegression()
lr_std_scaling.fit(X_train_cal_std, y_train_cal)
metrics, y_pred_lr_std_scaling = evaluate_regression_model(lr_std_scaling, X_train_cal_std, y_train_cal, X_test_cal_std, y_test_cal, 'Linear Regression', 'StandardScaler')
all_regression_results.append(metrics)

if metrics['r2_test'] > best_r2_test:
    best_r2_test = metrics['r2_test']
    best_model_info = metrics
    best_model_predictions = y_pred_lr_std_scaling
    best_model_actuals = y_test_cal

# --- Regressão Linear com MinMaxScaler ---
scaler_minmax = MinMaxScaler()
X_train_cal_minmax = scaler_minmax.fit_transform(X_train_cal)
X_test_cal_minmax = scaler_minmax.transform(X_test_cal)

lr_minmax_scaling = LinearRegression()
lr_minmax_scaling.fit(X_train_cal_minmax, y_train_cal)
metrics, y_pred_lr_minmax_scaling = evaluate_regression_model(lr_minmax_scaling, X_train_cal_minmax, y_train_cal, X_test_cal_minmax, y_test_cal, 'Linear Regression', 'MinMaxScaler')
all_regression_results.append(metrics)

if metrics['r2_test'] > best_r2_test:
    best_r2_test = metrics['r2_test']
    best_model_info = metrics
    best_model_predictions = y_pred_lr_minmax_scaling
    best_model_actuals = y_test_cal

knn_k_values = [3, 5, 7] # Experimente diferentes K para KNN

for k in knn_k_values:
    # --- KNN Regressor sem Scaling ---
    knn_no_scaling = KNeighborsRegressor(n_neighbors=k)
    knn_no_scaling.fit(X_train_cal, y_train_cal)
    metrics, y_pred_knn_no_scaling = evaluate_regression_model(knn_no_scaling, X_train_cal, y_train_cal, X_test_cal, y_test_cal, f'KNN Regressor (K={k})', 'No Scaling')
    all_regression_results.append(metrics)
    if metrics['r2_test'] > best_r2_test:
        best_r2_test = metrics['r2_test']
        best_model_info = metrics
        best_model_predictions = y_pred_knn_no_scaling
        best_model_actuals = y_test_cal

    # --- KNN Regressor com StandardScaler ---
    knn_std_scaling = KNeighborsRegressor(n_neighbors=k)
    knn_std_scaling.fit(X_train_cal_std, y_train_cal)
    metrics, y_pred_knn_std_scaling = evaluate_regression_model(knn_std_scaling, X_train_cal_std, y_train_cal, X_test_cal_std, y_test_cal, f'KNN Regressor (K={k})', 'StandardScaler')
    all_regression_results.append(metrics)
    if metrics['r2_test'] > best_r2_test:
        best_r2_test = metrics['r2_test']
        best_model_info = metrics
        best_model_predictions = y_pred_knn_std_scaling
        best_model_actuals = y_test_cal

    # --- KNN Regressor com MinMaxScaler ---
    knn_minmax_scaling = KNeighborsRegressor(n_neighbors=k)
    knn_minmax_scaling.fit(X_train_cal_minmax, y_train_cal)
    metrics, y_pred_knn_minmax_scaling = evaluate_regression_model(knn_minmax_scaling, X_train_cal_minmax, y_train_cal, X_test_cal_minmax, y_test_cal, f'KNN Regressor (K={k})', 'MinMaxScaler')
    all_regression_results.append(metrics)
    if metrics['r2_test'] > best_r2_test:
        best_r2_test = metrics['r2_test']
        best_model_info = metrics
        best_model_predictions = y_pred_knn_minmax_scaling
        best_model_actuals = y_test_cal


df_regression_results = pd.DataFrame(all_regression_results)
print("\n--- Tabela Comparativa de Resultados de Regressão ---")
display(df_regression_results.round(4))

print("\n--- Melhor Modelo Identificado ---")
print(f"Modelo: {best_model_info['model_name']}")
print(f"Scaler: {best_model_info['scaler']}")
print(f"R² no Teste: {best_model_info['r2_test']:.4f}")

print("\nAnálise de Overfitting/Underfitting para cada modelo:")
for index, row in df_regression_results.iterrows():
    model_name = row['model_name']
    scaler_name = row['scaler']
    r2_train = row['r2_train']
    r2_test = row['r2_test']
    mae_train = row['mae_train']
    mae_test = row['mae_test']

    diff_r2 = r2_train - r2_test
    diff_mae = mae_test - mae_train

    if diff_r2 > 0.1 and diff_mae > 0.1: # Thresholds para identificar overfitting, podem ser ajustados
        status = "Overfitting (R² de treino significativamente maior que R² de teste)"
    elif r2_train < 0.5 and r2_test < 0.5: # Thresholds para underfitting
        status = "Underfitting (Baixo desempenho em ambos os conjuntos)"
    else:
        status = "Bom balanço (Sem sinais claros de overfitting/underfitting)"

    print(f"- {model_name} ({scaler_name}): R² Treino={r2_train:.4f}, R² Teste={r2_test:.4f}, Status: {status}")


# Gráfico de dispersão entre valores previstos e valores reais para o melhor modelo
plt.figure(figsize=(10, 7))
sns.scatterplot(x=best_model_actuals, y=best_model_predictions, alpha=0.6)
plt.plot([best_model_actuals.min(), best_model_actuals.max()], [best_model_actuals.min(), best_model_actuals.max()], 'r--', lw=2)
plt.title(f'Predicted vs. Actual Values para o Melhor Modelo:\n{best_model_info["model_name"]} com {best_model_info["scaler"]}')
plt.xlabel('Valores Reais (y_test)')
plt.ylabel('Valores Previstos (y_pred)')
plt.grid(True, linestyle='--', alpha=0.7)
plt.show()
